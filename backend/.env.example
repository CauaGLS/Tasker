# --- Django core ---
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (Postgres) ---
POSTGRES_DB=tasker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- CORS ---
# Comma-separated list of allowed frontend origins (e.g. your Vercel URL).
# If unset, all origins are allowed (fine for local dev, not for production).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Timezone used by Django/Celery ---
TIME_ZONE=America/Sao_Paulo

# --- Redis / Celery / Channels (all OPTIONAL) ---
# This app runs in a simplified mode when REDIS_URL is not set:
#   - CHANNEL_LAYERS falls back to the in-memory layer (no external broker
#     needed, works fine for a single-process deployment).
#   - Celery tasks run eagerly (synchronously, in the same process) instead
#     of requiring a separate worker process.
# Set REDIS_URL (and optionally CELERY_BROKER_URL / CELERY_RESULT_BACKEND if
# they should point somewhere different than REDIS_URL) to restore real
# async task execution and multi-process realtime broadcasting.
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# --- Object storage (S3-compatible, for uploaded media) ---
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_SIGNATURE_VERSION=

# --- Sentry (optional) ---
SENTRY_DSN=
