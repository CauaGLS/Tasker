# --- Backend API ---
# Base URL of the Django backend (used by app/api/[[...proxy]]/route.ts to
# proxy requests, and by hooks/use-websocket.tsx which derives the ws(s)://
# URL from it by replacing the http scheme).
NEXT_PUBLIC_SERVER_URL=http://localhost:8000

# --- Frontend ---
# Public URL of this Next.js app itself (used as better-auth's trusted
# origin / base URL).
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Internal URL better-auth's own middleware uses to call back into this
# app's /api/auth/get-session route. Usually the same as NEXT_PUBLIC_FRONTEND_URL.
BETTER_AUTH_URL=http://localhost:3000

# Secret used by better-auth to sign sessions/tokens. Required in production.
BETTER_AUTH_SECRET=

# --- Auth database (better-auth talks to Postgres directly) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=tasker

# --- GitHub OAuth (better-auth social login) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Transactional email (password reset) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Sentry (optional) ---
# Falls back to the project's default DSN if unset. Set to an empty value
# and remove the fallback in sentry.*.config.ts if you need to disable
# Sentry entirely for a given environment.
NEXT_PUBLIC_SENTRY_DSN=
